default menu.c32
prompt 0
timeout 600

menu title PXE Boot Menu
label rocky-hpe
  menu label Install Rocky 8 ^HPE
  kernel vmlinuz
  append initrd=initrd.img inst.stage2={{ rocky_base_url }} inst.ks={{ kickstart_url | regex_replace('{{ vendor }}', 'hpe') }} ip={{ pxe_server_ip }}::
label rocky-dell
  menu label Install Rocky 8 ^Dell
  kernel vmlinuz
  append initrd=initrd.img inst.stage2={{ rocky_base_url }} inst.ks={{ kickstart_url | regex_replace('{{ vendor }}', 'dell') }} ip={{ pxe_server_ip }}::
label local
  menu label Boot from ^Local
  localboot 0

# vmlinuz/initrd는 Rocky ISO에서 /images/pxeboot/ 복사.